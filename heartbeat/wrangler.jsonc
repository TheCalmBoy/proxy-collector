{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/schema.json",
  "name": "proxy-pipeline-heartbeat",
  "main": "index.js",
  "compatibility_date": "2026-09-23",
  // 10-minute beat. Database updates land every 30 min; probes run every 10 min
  // (probe-egress.yml fires when the watchdog sees a >10-min health gap).
  // A single shared cadence avoids GitHub's best-effort scheduler drifting
  // against Cloudflare's, and keeps probe/update overlap within one tick.
  // Cloudflare free-tier crons are best-effort within a ~60s window; the
  // watchdog's freshness gate absorbs jitter (pool >30 min -> update,
  // health >10 min -> probe, both fresh -> no-op).
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}
