{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/schema.json",
  "name": "proxy-pipeline-heartbeat",
  "main": "index.js",
  "compatibility_date": "2026-09-23",
  // 5-minute beat. Mismatches with GitHub's 30-min cadence are absorbed by the
  // watchdog's freshness gate, which no-ops when the pool is <50 min old.
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
